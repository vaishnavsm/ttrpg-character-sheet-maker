  "required": [
    "version",
    "name",
    "system",
    "paper",
    "identity",
    "attributes",
    "defenses",
    "savingThrows",
    "skills",
    "resources",
    "attacks",
    "features",
    "equipment",
    "proficiencies",
    "personality",
    "sections",
    "notes"
