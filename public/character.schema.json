    "sections": {
      "default": [],
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "column": {
            "default": "right",
            "type": "string",
            "enum": [
              "left",
              "middle",
              "right"
            ]
          },
          "entries": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "description": {
                  "default": "",
                  "type": "string",
                  "maxLength": 8000
                }
              },
              "required": [
                "name",
                "description"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "column",
          "entries"
        ],
        "additionalProperties": false
      }
