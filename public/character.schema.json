        "spells": {
          "default": [],
          "maxItems": 150,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "description": {
                "default": "",
                "type": "string",
                "maxLength": 8000
              },
              "level": {
                "type": "string",
                "maxLength": 40
              }
            },
            "required": [
              "name",
              "description",
              "level"
            ],
            "additionalProperties": false
          }
        }
