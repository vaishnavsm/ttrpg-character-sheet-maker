{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "system": {
      "type": "string",
      "enum": [
        "dnd-5e-2014",
        "dnd-5e-2024",
        "generic"
      ]
    },
    "systemName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "paper": {
      "default": "a4",
      "type": "string",
      "enum": [
        "a4",
        "letter"
      ]
    },
    "identity": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "number"
              }
            ]
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "attributes": {
      "default": [],
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "number"
              }
            ]
          },
          "modifier": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "number"
              }
            ]
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "defenses": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "number"
              }
            ]
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "savingThrows": {
      "default": [],
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "bonus": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "number"
              }
            ]
          },
          "proficient": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "bonus",
          "proficient"
        ],
        "additionalProperties": false
      }
    },
    "skills": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "bonus": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "number"
              }
            ]
