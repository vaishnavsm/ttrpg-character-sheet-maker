  "features": [
    {
      "name": "Colossus Slayer",
      "description": "Once per turn, hit a creature below its maximum HP for +1d8 damage. No resource cost."
    },
    {
      "name": "Archery",
      "description": "+2 to ranged weapon attack rolls; included in Longbow +7."
    },
    {
      "name": "Favored Enemy — Beasts",
      "description": "Advantage on Survival to track Beasts and Intelligence to remember information about Beasts."
    },
    {
      "name": "Natural Explorer — Forest",
      "description": "After at least an hour of forest travel: difficult terrain does not slow the group; cannot become lost except magically; remain alert while doing another travel task; tracking reveals number, sizes and how long ago creatures passed; find twice as much food while foraging."
    },
    {
      "name": "Primeval Awareness",
      "description": "Sense whether Aberrations, Celestials, Dragons, Elementals, Fey, Fiends, or Undead are nearby. Normally within 1 mile; in your favored Forest terrain, 6 miles. You do not learn their exact location or number.",
      "summary": "Sense supernatural creatures within 1 mile (forest: 6).",
